<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="fr.vpm.yag.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="fr.vpm.yag.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_navigation_dashboard_to_albumDetailFragment"
            app:destination="@id/albumDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="fr.vpm.yag.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="fr.vpm.yag.ui.settings.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/albumDetailFragment"
        android:name="fr.vpm.yag.ui.album.AlbumDetailFragment"
        android:label="Album Detail"
        tools:layout="@layout/fragment_album_detail">
        <argument
            android:name="albumId"
            app:argType="string" />
        <action
            android:id="@+id/action_albumDetailFragment_to_photoViewerFragment"
            app:destination="@id/photoViewerFragment" />
    </fragment>

    <fragment
        android:id="@+id/photoViewerFragment"
        android:name="fr.vpm.yag.ui.album.PhotoViewerFragment"
        android:label="Photo Viewer"
        tools:layout="@layout/fragment_photo_viewer">
        <argument
            android:name="albumId"
            app:argType="string" />
        <argument
            android:name="photoPosition"
            app:argType="integer" />
    </fragment>
</navigation>